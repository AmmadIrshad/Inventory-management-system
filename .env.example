# Copy to `.env` and fill in the blanks:  cp .env.example .env
# `.env` is read by Next.js, the Prisma CLI, podman compose and the test runner.

# ── App ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Encrypts TOTP secrets at rest. 32 random bytes, base64:  openssl rand -base64 32
# Changing it later makes every enrolled authenticator unreadable.
ENCRYPTION_KEY=

# ── PostgreSQL (container settings + connection strings) ───────────
POSTGRES_USER=inventory
POSTGRES_PASSWORD=
POSTGRES_DB=inventory
# Used by `npm run dev` and the Prisma CLI on the host. Keep in sync with the values above.
DATABASE_URL=postgresql://inventory:CHANGE_ME@localhost:5432/inventory
# Separate database for `npm test` (created automatically; name must end in _test).
TEST_DATABASE_URL=postgresql://inventory:CHANGE_ME@localhost:5432/inventory_test

# ── Email (SMTP) ────────────────────────────────────────────────────
# Defaults deliver into the Mailpit container: open http://localhost:8025 to read mail.
# For a real provider (Gmail app password, Resend, Brevo, SES...) replace these values.
SMTP_HOST=localhost
SMTP_PORT=1025
# true for implicit TLS (usually port 465); false uses STARTTLS when the server offers it.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Inventory <no-reply@inventory.local>"
# SMTP host as seen from the *app container* (`--profile app`). Keep "mailpit" for the
# local inbox; set it to the same value as SMTP_HOST when using a real provider.
CONTAINER_SMTP_HOST=mailpit
