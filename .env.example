# Create your .env with generated secrets:  ./scripts/init-env.sh
# `.env` is read by Next.js, the Prisma CLI, podman compose and the test runner.

# ── App ─────────────────────────────────────────────────────────────
# The address people open. Production: https://your-domain (cookies become Secure).
APP_URL=http://localhost:3000
# Where the app container listens: 127.0.0.1 = this machine only (use with the https
# profile), 0.0.0.0 = reachable from your network over plain HTTP.
APP_BIND=127.0.0.1
APP_PORT=3000
# Only for `podman compose --profile https` (Nginx + Let's Encrypt): your domain, with DNS
# pointing at this server. Then set APP_URL=https://<DOMAIN>. Empty = localhost (self-signed test).
DOMAIN=
# Optional: email for your Let's Encrypt account (used for account recovery and policy notices).
LETSENCRYPT_EMAIL=
# true = use Let's Encrypt's test servers while trying things out (browsers won't trust the
# certificate). Delete the letsencrypt volume before switching back to false.
LETSENCRYPT_STAGING=false
# Encrypts TOTP secrets at rest. 32 random bytes, base64:  openssl rand -base64 32
# Never change it after launch: every enrolled authenticator would become unreadable.
ENCRYPTION_KEY=

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=inventory
POSTGRES_PASSWORD=
POSTGRES_DB=inventory
# Host folder that stores the database files (absolute, or relative to this project).
POSTGRES_DATA_DIR=./data/postgres
# Used by `npm run dev` and the Prisma CLI on the host. Keep in sync with the values above.
DATABASE_URL=postgresql://inventory:CHANGE_ME@localhost:5432/inventory
# Separate database for `npm test` (created automatically; name must end in _test).
TEST_DATABASE_URL=postgresql://inventory:CHANGE_ME@localhost:5432/inventory_test

# ── Email (SMTP) ────────────────────────────────────────────────────
# Development: the Mailpit container (inbox at http://localhost:8025).
# Production: your provider's SMTP settings (Brevo, Resend, Amazon SES, Gmail app password…).
SMTP_HOST=localhost
SMTP_PORT=1025
# true for implicit TLS (usually port 465); false uses STARTTLS when offered (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Inventory <no-reply@inventory.local>"
# Optional: SMTP host as seen from the app *container*, if different from SMTP_HOST.
# Set to "mailpit" to test the full container stack locally with the dev inbox.
CONTAINER_SMTP_HOST=

# ── Google sign-in (optional) ───────────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
